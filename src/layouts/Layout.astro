---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Design System Unifié — Nakôbio × Biosain", 
  description = "Spécifications, tokens, composants et charte graphique pour Nakôbio, Biosain, Campus et les documents pédagogiques." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="fr" data-theme="nakobio">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  
  <!-- Inclusions directes des tokens partagés -->
  <link rel="stylesheet" href="/tokens/tokens.css" />
  <link rel="stylesheet" href="/tokens/themes.css" />
  <link rel="stylesheet" href="/components/steps.css" />
  <link rel="stylesheet" href="/components/callouts.css" />
  <link rel="stylesheet" href="/components/cards.css" />
  <link rel="stylesheet" href="/components/tables.css" />
  <link rel="stylesheet" href="/tokens/print.css" />

  <style is:global>
    *, *::before, *::after {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;
      background-color: var(--color-surface);
      color: var(--color-ink);
      font-family: var(--font-sans);
      font-size: var(--text-base);
      line-height: var(--leading-relaxed);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* Utilitaires typographiques */
    .font-serif { font-family: var(--font-serif); }
    .font-sans { font-family: var(--font-sans); }
    .font-mono { font-family: var(--font-mono); }

    /* Navigation header */
    .site-nav {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(255, 253, 246, 0.92);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--color-border);
      padding: var(--space-4) var(--space-6);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
    }

    .nav-brand {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      text-decoration: none;
      color: var(--color-ink);
    }

    .nav-brand-logo {
      width: 32px;
      height: 32px;
      border-radius: var(--radius-sm);
      background: var(--color-brand-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-surface);
      font-family: var(--font-serif);
      font-weight: var(--weight-bold);
      font-size: 1.1rem;
    }

    .nav-brand-title {
      font-family: var(--font-serif);
      font-size: var(--text-lg);
      font-weight: var(--weight-bold);
      letter-spacing: -0.01em;
    }

    .nav-brand-badge {
      font-family: var(--font-sans);
      font-size: var(--text-xs);
      background: var(--color-surface-sunken);
      color: var(--color-ink-soft);
      padding: 2px 8px;
      border-radius: var(--radius-full);
      font-weight: var(--weight-semibold);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: var(--space-5);
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .nav-link {
      color: var(--color-ink-soft);
      text-decoration: none;
      font-size: var(--text-sm);
      font-weight: var(--weight-medium);
      transition: color 0.15s ease;
    }

    .nav-link:hover {
      color: var(--color-brand-primary);
    }

    /* Switcher interactif */
    .theme-toggle-bar {
      display: flex;
      align-items: center;
      background: var(--color-surface-sunken);
      padding: 3px;
      border-radius: var(--radius-full);
      border: 1px solid var(--color-border);
    }

    .theme-toggle-btn {
      border: none;
      background: transparent;
      padding: 4px 12px;
      font-size: var(--text-xs);
      font-family: var(--font-sans);
      font-weight: var(--weight-semibold);
      color: var(--color-ink-soft);
      border-radius: var(--radius-full);
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .theme-toggle-btn.active {
      background: var(--color-surface-card);
      color: var(--color-brand-primary);
      box-shadow: var(--shadow-sm);
    }

    /* Layout conteneur */
    .page-container {
      max-width: 1140px;
      margin: 0 auto;
      padding: var(--space-8) var(--space-6) var(--space-16);
    }

    /* Footer */
    .site-footer {
      border-top: 1px solid var(--color-border);
      padding: var(--space-8) var(--space-6);
      text-align: center;
      color: var(--color-ink-faint);
      font-size: var(--text-sm);
      background: var(--color-surface-card);
    }
  </style>
</head>
<body>
  <nav class="site-nav no-print" aria-label="Navigation principale">
    <a href="/" class="nav-brand">
      <div class="nav-brand-logo">N</div>
      <div>
        <span class="nav-brand-title">Nakôbio × Biosain</span>
        <span class="nav-brand-badge">Design System v1.0</span>
      </div>
    </a>

    <ul class="nav-links">
      <li><a href="#vision" class="nav-link">Vision</a></li>
      <li><a href="#typography" class="nav-link">Typographie</a></li>
      <li><a href="#colors" class="nav-link">Couleurs</a></li>
      <li><a href="#components" class="nav-link">Composants</a></li>
      <li><a href="#code-ai" class="nav-link">Directives Dev/IA</a></li>
    </ul>

    <div class="theme-toggle-bar">
      <button class="theme-toggle-btn active" id="btn-nakobio" onclick="switchTheme('nakobio')">Nakôbio</button>
      <button class="theme-toggle-btn" id="btn-biosain" onclick="switchTheme('biosain')">Biosain</button>
    </div>
  </nav>

  <div class="page-container">
    <slot />
  </div>

  <footer class="site-footer no-print">
    <p>Nakôbio × Biosain — Design System Unifié pour Vitrine, Campus, Maraîchage & Édition.</p>
    <p style="font-size: var(--text-xs); margin-top: 4px;">Propulsé par Astro & Dokploy sur <code>deploy.pulsation.cloud</code> (Projet <code>nakobio</code>) — Domaine : <code>design.nako.bio</code></p>
  </footer>

  <script is:inline>
    function switchTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      const btnNako = document.getElementById('btn-nakobio');
      const btnBio = document.getElementById('btn-biosain');
      if (theme === 'nakobio') {
        btnNako.classList.add('active');
        btnBio.classList.remove('active');
      } else {
        btnBio.classList.add('active');
        btnNako.classList.remove('active');
      }
    }
  </script>
</body>
</html>
