---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Design System Unifié — Nakôbio × Biosain", 
  description = "Spécifications, tokens, composants et charte graphique pour Nakôbio, Biosain, Campus et les documents pédagogiques." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="fr" data-theme="nakobio">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  
  <!-- Inclusions directes des tokens partagés -->
  <link rel="stylesheet" href="/tokens/tokens.css" />
  <link rel="stylesheet" href="/tokens/themes.css" />
  <link rel="stylesheet" href="/components/buttons.css" />
  <link rel="stylesheet" href="/components/badges.css" />
  <link rel="stylesheet" href="/components/steps.css" />
  <link rel="stylesheet" href="/components/callouts.css" />
  <link rel="stylesheet" href="/components/cards.css" />
  <link rel="stylesheet" href="/components/tables.css" />
  <link rel="stylesheet" href="/components/forms.css" />
  <link rel="stylesheet" href="/tokens/print.css" />

  <style is:global>
    *, *::before, *::after {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      padding: 0;
      background-color: var(--color-surface);
      color: var(--color-ink);
      font-family: var(--font-sans);
      font-size: var(--text-base);
      line-height: var(--leading-relaxed);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* Utilitaires typographiques */
    .font-serif { font-family: var(--font-serif); }
    .font-sans { font-family: var(--font-sans); }
    .font-mono { font-family: var(--font-mono); }

    /* ======================================================================
       NAVIGATION GLASSMORPHISM
       ====================================================================== */
    .site-nav {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(255, 253, 246, 0.75);
      backdrop-filter: blur(var(--blur-md));
      -webkit-backdrop-filter: blur(var(--blur-md));
      border-bottom: 1px solid rgba(27, 35, 24, 0.08);
      padding: var(--space-3) var(--space-6);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      box-shadow: 0 1px 20px rgba(27, 35, 24, 0.06);
      transition: background var(--transition-base), box-shadow var(--transition-base);
    }

    .site-nav.scrolled {
      background: rgba(255, 253, 246, 0.92);
      box-shadow: 0 2px 24px rgba(27, 35, 24, 0.10);
    }

    /* Logo brand */
    .nav-brand {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      text-decoration: none;
      color: var(--color-ink);
      flex-shrink: 0;
    }

    .nav-brand-logo {
      font-family: var(--font-serif);
      font-size: var(--text-lg);
      font-weight: var(--weight-bold);
      letter-spacing: -0.01em;
    }

    .nav-brand-badge {
      font-family: var(--font-sans);
      font-size: var(--text-xs);
      background: var(--color-surface-sunken);
      color: var(--color-ink-soft);
      padding: 2px 8px;
      border-radius: var(--radius-full);
      font-weight: var(--weight-semibold);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: var(--space-5);
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .nav-link {
      color: var(--color-ink-soft);
      text-decoration: none;
      font-size: var(--text-sm);
      font-weight: var(--weight-medium);
      transition: color 0.15s ease;
    }

    .nav-link:hover {
      color: var(--color-brand-primary);
    }

    /* Switcher interactif */
    .theme-toggle-bar {
      display: flex;
      align-items: center;
      background: var(--color-surface-sunken);
      padding: 3px;
      border-radius: var(--radius-full);
      border: 1px solid var(--color-border);
      flex-shrink: 0;
    }

    .theme-toggle-btn {
      border: none;
      background: transparent;
      padding: 4px 12px;
      font-size: var(--text-xs);
      font-family: var(--font-sans);
      font-weight: var(--weight-semibold);
      color: var(--color-ink-soft);
      border-radius: var(--radius-full);
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .theme-toggle-btn.active {
      background: var(--color-surface-card);
      color: var(--color-brand-primary);
      box-shadow: var(--shadow-sm);
    }

    .nav-actions-group {
      display: flex;
      align-items: center;
      gap: var(--space-3);
    }

    /* Burger Mobile */
    .nav-burger-btn {
      display: none;
      background: var(--color-surface-card);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      padding: 6px 8px;
      color: var(--color-ink);
      cursor: pointer;
      align-items: center;
      justify-content: center;
      transition: background 0.15s ease;
    }

    .nav-burger-btn:hover {
      background: var(--color-surface-sunken);
    }

    /* Layout conteneur */
    .page-container {
      --page-pad: var(--space-6);
      max-width: 1140px;
      margin: 0 auto;
      padding: var(--space-8) var(--page-pad) var(--space-16);
    }

    /* Responsive Mobile */
    @media (max-width: 860px) {
      .site-nav {
        padding: var(--space-3) var(--space-4);
        flex-wrap: wrap;
      }

      .nav-burger-btn {
        display: inline-flex;
      }

      .nav-links {
        display: none;
        width: 100%;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-2);
        padding-top: var(--space-4);
        margin-top: var(--space-2);
        border-top: 1px solid var(--color-border);
      }

      .nav-links.is-open {
        display: flex;
      }

      .nav-links li {
        width: 100%;
      }

      .nav-link {
        display: block;
        padding: var(--space-2) var(--space-3);
        border-radius: var(--radius-sm);
        width: 100%;
      }

      .nav-link:hover {
        background: var(--color-surface-sunken);
      }

      .nav-brand-badge {
        display: none;
      }

      .page-container {
        --page-pad: var(--space-4);
        padding: var(--space-4) var(--page-pad) var(--space-10);
      }
    }

    /* ======================================================================
       FOOTER
       ====================================================================== */
    .site-footer {
      border-top: 1px solid var(--color-border);
      padding: var(--space-10) var(--space-6);
      text-align: center;
      color: var(--color-ink-faint);
      font-size: var(--text-sm);
      background: var(--color-surface-card);
    }

    .footer-ecosystem {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: var(--space-4);
      margin-bottom: var(--space-4);
      flex-wrap: wrap;
    }

    .footer-ecosystem a {
      color: var(--color-ink-soft);
      text-decoration: none;
      font-size: var(--text-xs);
      font-weight: var(--weight-medium);
      transition: color var(--transition-fast);
      padding: 2px 0;
      border-bottom: 1px solid transparent;
    }

    .footer-ecosystem a:hover {
      color: var(--color-brand-primary);
      border-bottom-color: var(--color-brand-primary);
    }

    .footer-sep {
      color: var(--color-border-strong);
    }

    .footer-legal {
      font-size: var(--text-xs);
      color: var(--color-ink-faint);
      margin-top: var(--space-2);
    }

    /* ======================================================================
       ANIMATIONS GLOBALES
       ====================================================================== */
    @media (prefers-reduced-motion: no-preference) {
      .fade-in-up {
        animation: fadeInUp 0.5s var(--transition-slow) both;
      }
    }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(12px); }
      to   { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body>
  <nav class="site-nav no-print" aria-label="Navigation principale" id="main-nav">
    <a href="/" class="nav-brand" aria-label="Nakôbio Design System — Accueil">
      <img src="/nakobio-logo.svg" alt="Nakôbio" class="nav-brand-logo" width="112" height="26" />
      <span class="nav-brand-badge">DS v1.0</span>
    </a>

    <ul class="nav-links" id="nav-links-menu">
      <li><a href="#vision" class="nav-link">Vue d'ensemble</a></li>
      <li><a href="#typography" class="nav-link">Typographie</a></li>
      <li><a href="#colors" class="nav-link">Couleurs &amp; Thèmes</a></li>
      <li><a href="#components" class="nav-link">Composants</a></li>
      <li><a href="#spacing" class="nav-link">Tokens</a></li>
      <li><a href="#code-ai" class="nav-link">Intégration &amp; IA</a></li>
    </ul>

    <div class="nav-actions-group">
      <div class="theme-toggle-bar">
        <button type="button" class="theme-toggle-btn active" id="btn-nakobio" onclick="switchTheme('nakobio')" title="Activer le thème Nakôbio (Mali)">Nakôbio</button>
        <button type="button" class="theme-toggle-btn" id="btn-biosain" onclick="switchTheme('biosain')" title="Activer le thème Biosain (Autriche)">Biosain</button>
      </div>
      <button type="button" class="nav-burger-btn" id="nav-burger-btn" aria-label="Ouvrir le menu de navigation" aria-expanded="false" aria-controls="nav-links-menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </nav>

  <div class="page-container">
    <slot />
  </div>

  <footer class="site-footer no-print">
    <div class="footer-ecosystem">
      <a href="https://nako.bio" target="_blank" rel="noopener">nako.bio</a>
      <span class="footer-sep">&middot;</span>
      <a href="https://biosain.at" target="_blank" rel="noopener">biosain.at</a>
      <span class="footer-sep">&middot;</span>
      <a href="https://campus.nako.bio" target="_blank" rel="noopener">campus.nako.bio</a>
      <span class="footer-sep">&middot;</span>
      <a href="https://design.nako.bio" target="_blank" rel="noopener">design.nako.bio</a>
    </div>
    <p class="footer-legal">
      Design System Unifié &middot; Usage interne et socle technique &middot;
      <code>Astro static</code>
    </p>
  </footer>

  <script is:inline>
    function switchTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      document.getElementById('btn-nakobio').classList.toggle('active', theme === 'nakobio');
      document.getElementById('btn-biosain').classList.toggle('active', theme === 'biosain');
    }

    // Burger mobile toggle
    const burgerBtn = document.getElementById('nav-burger-btn');
    const linksMenu = document.getElementById('nav-links-menu');
    if (burgerBtn && linksMenu) {
      burgerBtn.addEventListener('click', () => {
        const isOpen = linksMenu.classList.toggle('is-open');
        burgerBtn.setAttribute('aria-expanded', isOpen.toString());
      });
      // Fermer le menu lors du clic sur un lien
      linksMenu.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          linksMenu.classList.remove('is-open');
          burgerBtn.setAttribute('aria-expanded', 'false');
        });
      });
    }

    const nav = document.getElementById('main-nav');
    window.addEventListener('scroll', () => {
      nav.classList.toggle('scrolled', window.scrollY > 20);
    }, { passive: true });
  </script>
</body>
</html>
