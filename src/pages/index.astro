---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Nakôbio × Biosain — Vitrine du Design System">

  <!-- ======================================================================
       HERO SECTION — UTILITAIRE & TECHNIQUE
       ====================================================================== -->
  <header class="hero-section" id="vision">
    <div class="hero-inner">
      <div class="hero-badge">Répertoire Technique &amp; Tokens CSS</div>
      <h1 class="hero-title">
        Design System Unifié<br />
        <em>Nakôbio × Biosain</em>
      </h1>
      <p class="hero-desc">
        Référentiel commun pour harmoniser les interfaces, formulaires et fiches de l'écosystème : 
        <strong>nako.bio</strong>, <strong>biosain.at</strong>, <strong>campus</strong> et les exports de cours imprimables.
      </p>

      <div class="hero-actions no-print">
        <a href="#typography" class="btn btn-primary">Typographie &amp; Échelle</a>
        <a href="#colors" class="btn btn-secondary">Couleurs &amp; Thèmes</a>
        <a href="#components" class="btn btn-secondary">Catalogue Composants</a>
        <a href="#spacing" class="btn btn-secondary">Tokens &amp; Formes</a>
        <a href="#code-ai" class="btn btn-ghost">Intégration &amp; llms.txt</a>
      </div>
    </div>
  </header>

  <!-- ======================================================================
       SECTION 1 : TYPOGRAPHIE
       ====================================================================== -->
  <section class="ds-section" id="typography">
    <div class="section-label">01. Typographie</div>
    <h2 class="section-heading">Playfair Display × Quicksand</h2>
    <p class="section-sub">
      Deux polices libres sous licence SIL OFL — Playfair Display apporte l'élégance
      éditoriale des magazines premium, Quicksand amène chaleur humaine et lisibilité mobile.
    </p>

    <div class="typo-grid">
      <div class="typo-card serif-card">
        <div class="typo-tag">Serif — Éditorial &amp; Titrage Premium</div>
        <div class="typo-specimen font-serif">Playfair Display</div>
        <p class="typo-preview font-serif">
          « Nourrir la terre pour que la terre nous nourrisse. »
        </p>
        <ul class="typo-rules">
          <li><strong>Rôles stricts :</strong> Titres h1, h2, h3, citations, repères chiffrés et numéros d'étapes (<code>01</code>, <code>02</code>).</li>
          <li><strong>Évocation :</strong> Contraste élevé, magazine haut de gamme, présence forte sur grand écran.</li>
          <li><strong>Tailles recommandées :</strong> 28px (h2) à 48px (hero/impact).</li>
          <li><strong>Poids disponibles :</strong> 400, 500, 600, 700, 800 — Italic 400 &amp; 600.</li>
        </ul>
      </div>

      <div class="typo-card sans-card">
        <div class="typo-tag">Sans-serif — Interface, Chaleur &amp; Rigueur</div>
        <div class="typo-specimen font-sans">Quicksand</div>
        <p class="typo-preview font-sans">
          Tuyau PE Ø 40 mm — Pression de service : 2.5 bars — Débit : 12 L/m linéaire.
        </p>
        <ul class="typo-rules">
          <li><strong>Rôles stricts :</strong> Textes courants, tableaux techniques, navigation, badges, boutons et formulaires.</li>
          <li><strong>Évocation :</strong> Arrondis doux, chaleur humaine — lisibilité optimale sur smartphone en plein soleil.</li>
          <li><strong>Tailles recommandées :</strong> 12px (légendes), 14px (UI), 16px (corps).</li>
          <li><strong>Poids disponibles :</strong> 300, 400, 500, 600, 700.</li>
        </ul>
      </div>
    </div>

    <h3 class="subsection-title" style="margin-top: var(--space-10);">Échelle Modulaire</h3>
    <div class="type-scale-list">
      <div class="type-scale-row">
        <span class="type-scale-label font-mono">--text-4xl · 48px</span>
        <span class="type-scale-sample font-serif" style="font-size: var(--text-4xl); line-height: 1.1;">Aa</span>
      </div>
      <div class="type-scale-row">
        <span class="type-scale-label font-mono">--text-3xl · 36px</span>
        <span class="type-scale-sample font-serif" style="font-size: var(--text-3xl);">Aa — Titre H1</span>
      </div>
      <div class="type-scale-row">
        <span class="type-scale-label font-mono">--text-2xl · 28px</span>
        <span class="type-scale-sample font-serif" style="font-size: var(--text-2xl);">Aa — Titre H2</span>
      </div>
      <div class="type-scale-row">
        <span class="type-scale-label font-mono">--text-xl · 21px</span>
        <span class="type-scale-sample font-serif" style="font-size: var(--text-xl);">Aa — Titre H3</span>
      </div>
      <div class="type-scale-row">
        <span class="type-scale-label font-mono">--text-lg · 18px</span>
        <span class="type-scale-sample font-sans" style="font-size: var(--text-lg);">Aa — Chapeau intro</span>
      </div>
      <div class="type-scale-row">
        <span class="type-scale-label font-mono">--text-base · 16px</span>
        <span class="type-scale-sample font-sans" style="font-size: var(--text-base);">Aa — Corps de texte</span>
      </div>
      <div class="type-scale-row">
        <span class="type-scale-label font-mono">--text-sm · 14px</span>
        <span class="type-scale-sample font-sans" style="font-size: var(--text-sm);">Aa — Métadonnées UI</span>
      </div>
      <div class="type-scale-row">
        <span class="type-scale-label font-mono">--text-xs · 12px</span>
        <span class="type-scale-sample font-sans" style="font-size: var(--text-xs);">Aa — Légendes &amp; badges</span>
      </div>
    </div>
  </section>

  <!-- ======================================================================
       SECTION 2 : COULEURS
       ====================================================================== -->
  <section class="ds-section" id="colors">
    <div class="section-label">02. Chromatique</div>
    <h2 class="section-heading">Socle Matières &amp; Déclinaisons de Marque</h2>
    <p class="section-sub">
      Les surfaces naturelles et encres végétales sont partagées. Les teintes de marque
      changent selon le contexte avec <code>data-theme</code>.
      Survolez les swatches pour les détails.
    </p>

    <h3 class="subsection-title">1. Socle Commun — Matières &amp; Sol</h3>
    <div class="color-swatches-grid">
      <div class="swatch-card">
        <div class="swatch-color" style="background-color: #FFFDF6; border-bottom: 1px solid rgba(27,35,24,0.1);">
          <div class="swatch-overlay"><span class="swatch-hex-large">#FFFDF6</span></div>
        </div>
        <div class="swatch-info">
          <span class="swatch-name">Surface Naturelle</span>
          <span class="swatch-hex font-mono">#FFFDF6</span>
          <span class="swatch-role">Fond principal — lin / parchemin</span>
          <code class="swatch-token">--color-surface</code>
        </div>
      </div>

      <div class="swatch-card">
        <div class="swatch-color" style="background-color: #F4EED8;">
          <div class="swatch-overlay"><span class="swatch-hex-large">#F4EED8</span></div>
        </div>
        <div class="swatch-info">
          <span class="swatch-name">Surface Sunken</span>
          <span class="swatch-hex font-mono">#F4EED8</span>
          <span class="swatch-role">Zones techniques &amp; callouts</span>
          <code class="swatch-token">--color-surface-sunken</code>
        </div>
      </div>

      <div class="swatch-card">
        <div class="swatch-color" style="background-color: #1B2318;">
          <div class="swatch-overlay"><span class="swatch-hex-large" style="color:#FFFDF6;">#1B2318</span></div>
        </div>
        <div class="swatch-info">
          <span class="swatch-name">Noir Végétal</span>
          <span class="swatch-hex font-mono">#1B2318</span>
          <span class="swatch-role">Encre de lecture principale</span>
          <code class="swatch-token">--color-ink</code>
        </div>
      </div>

      <div class="swatch-card">
        <div class="swatch-color" style="background-color: #43492F;">
          <div class="swatch-overlay"><span class="swatch-hex-large" style="color:#FFFDF6;">#43492F</span></div>
        </div>
        <div class="swatch-info">
          <span class="swatch-name">Vert Olive Sombre</span>
          <span class="swatch-hex font-mono">#43492F</span>
          <span class="swatch-role">Textes secondaires</span>
          <code class="swatch-token">--color-ink-soft</code>
        </div>
      </div>

      <div class="swatch-card">
        <div class="swatch-color" style="background-color: #6B684E;">
          <div class="swatch-overlay"><span class="swatch-hex-large" style="color:#FFFDF6;">#6B684E</span></div>
        </div>
        <div class="swatch-info">
          <span class="swatch-name">Terre d'Ombre</span>
          <span class="swatch-hex font-mono">#6B684E</span>
          <span class="swatch-role">Métadonnées &amp; légendes</span>
          <code class="swatch-token">--color-ink-faint</code>
        </div>
      </div>
    </div>

    <h3 class="subsection-title" style="margin-top: var(--space-10);">2. Déclinaisons Spécifiques par Marque</h3>
    <div class="brand-comparison-grid">
      <div class="brand-box">
        <div class="brand-header">
          <h4 class="font-serif">Nakôbio <span class="brand-subtitle">Mali / Sahel</span></h4>
          <code class="badge-tag">data-theme="nakobio"</code>
        </div>
        <p class="brand-desc">Agroécologie sahélienne, semences paysannes reproductibles et pédagogie de terrain.</p>
        <div class="brand-swatches">
          <div class="mini-swatch" style="background-color: #2F4A34;">
            <span class="mini-swatch-label">PRIMARY</span>
            <span class="mini-swatch-hex font-mono">#2F4A34</span>
          </div>
          <div class="mini-swatch" style="background-color: #C86832;">
            <span class="mini-swatch-label">SECONDARY</span>
            <span class="mini-swatch-hex font-mono">#C86832</span>
          </div>
          <div class="mini-swatch" style="background-color: #E0A030; color: #1B2318;">
            <span class="mini-swatch-label">ACCENT</span>
            <span class="mini-swatch-hex font-mono">#E0A030</span>
          </div>
        </div>
      </div>

      <div class="brand-box">
        <div class="brand-header">
          <h4 class="font-serif">Biosain <span class="brand-subtitle">Autriche / Europe</span></h4>
          <code class="badge-tag">data-theme="biosain"</code>
        </div>
        <p class="brand-desc">Maraîchage bio-intensif de précision, circuits courts et multiplication de semences.</p>
        <div class="brand-swatches">
          <div class="mini-swatch" style="background-color: #CAAE00; color: #1B2318;">
            <span class="mini-swatch-label">PRIMARY</span>
            <span class="mini-swatch-hex font-mono">#CAAE00</span>
          </div>
          <div class="mini-swatch" style="background-color: #2F4A34;">
            <span class="mini-swatch-label">SECONDARY</span>
            <span class="mini-swatch-hex font-mono">#2F4A34</span>
          </div>
          <div class="mini-swatch" style="background-color: #1E3324;">
            <span class="mini-swatch-label">ACCENT</span>
            <span class="mini-swatch-hex font-mono">#1E3324</span>
          </div>
        </div>
      </div>
    </div>

    <div class="dynamic-brand-demo no-print" style="margin-top: var(--space-8);">
      <h3 class="subsection-title">3. Tokens Actifs (thème courant)</h3>
      <div class="dynamic-swatches">
        <div class="dynamic-swatch">
          <div class="dynamic-swatch-color" style="background: var(--color-brand-primary);"></div>
          <code class="dynamic-swatch-token">--color-brand-primary</code>
        </div>
        <div class="dynamic-swatch">
          <div class="dynamic-swatch-color" style="background: var(--color-brand-secondary);"></div>
          <code class="dynamic-swatch-token">--color-brand-secondary</code>
        </div>
        <div class="dynamic-swatch">
          <div class="dynamic-swatch-color" style="background: var(--color-brand-accent);"></div>
          <code class="dynamic-swatch-token">--color-brand-accent</code>
        </div>
        <div class="dynamic-swatch">
          <div class="dynamic-swatch-color" style="background: var(--gradient-brand);"></div>
          <code class="dynamic-swatch-token">--gradient-brand</code>
        </div>
        <div class="dynamic-swatch">
          <div class="dynamic-swatch-color" style="background: var(--gradient-hero);"></div>
          <code class="dynamic-swatch-token">--gradient-hero</code>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================================================================
       SECTION 3 : COMPOSANTS
       ====================================================================== -->
  <section class="ds-section" id="components">
    <div class="section-label">03. Composants</div>
    <h2 class="section-heading">Composants Modulaires en Action</h2>
    <p class="section-sub">Les composants s'adaptent automatiquement au thème actif (essayez de basculer entre Nakôbio et Biosain en haut à droite).</p>

    <h3 class="subsection-title">Boutons</h3>
    <div class="buttons-demo no-print">
      <a href="#" class="btn btn-primary">Primaire</a>
      <a href="#" class="btn btn-secondary">Secondaire</a>
      <a href="#" class="btn btn-accent">Accent</a>
      <a href="#" class="btn btn-ghost">Ghost</a>
    </div>

    <h3 class="subsection-title" style="margin-top: var(--space-8);">Cartouche d'Étape Pédagogique</h3>
    <div class="steps-list">
      <article class="step-card">
        <div class="step-header">
          <div class="step-meta-group">
            <span class="step-number">01</span>
            <h4 class="step-title">Repérage des lignes et tension des cordeaux</h4>
          </div>
          <span class="step-badge">15 minutes</span>
        </div>
        <div class="step-body">
          <p>Aligner les jalons aux deux extrémités de la parcelle. Une planche standard fait exactement <strong>75 cm</strong> de largeur utile avec un passe-pied de <strong>40 cm</strong>.</p>
        </div>
      </article>

      <article class="step-card">
        <div class="step-header">
          <div class="step-meta-group">
            <span class="step-number">02</span>
            <h4 class="step-title">Incorporation de compost de surface</h4>
          </div>
          <span class="step-badge">30 minutes</span>
        </div>
        <div class="step-body">
          <p>Étaler uniformément 4 brouettes de compost mûr par planche de 30 mètres sans enfouir profondément afin de nourrir les vers et la microfaune de surface.</p>
        </div>
      </article>
    </div>

    <h3 class="subsection-title" style="margin-top: var(--space-8);">Encadrés de Conseils &amp; Alertes</h3>
    <div class="callout callout-tip">
      <div class="callout-title">Bonne pratique agronomique</div>
      Toujours couvrir immédiatement après l'amendement (paillage de paille de mil ou bâche occultante) pour préserver l'humidité et les micro-organismes du sol.
    </div>

    <div class="callout callout-warning">
      <div class="callout-title">Point de vigilance</div>
      Ne pas tasser le lit de semence lors de la pose des asperseurs. Marchez exclusivement dans les passe-pieds de 40 cm.
    </div>

    <h3 class="subsection-title" style="margin-top: var(--space-8);">Tableaux Techniques &amp; Dosages</h3>
    <div class="table-container">
      <table class="table-tech">
        <thead>
          <tr>
            <th>Composant / Étape</th>
            <th>Type de matériel</th>
            <th>Dosage / Cote</th>
            <th>Notes de terrain</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Planche standard</td>
            <td>Sol meuble permanent</td>
            <td class="num-val">75 cm</td>
            <td>Compatible rouleau rayonneur &amp; filets</td>
          </tr>
          <tr>
            <td>Tuyauterie principale</td>
            <td>Polyéthylène haute densité</td>
            <td class="num-val">Ø 40 mm</td>
            <td>Pression d'entrée recommandée : 2.8 bars</td>
          </tr>
          <tr>
            <td>Fertilisation de fond</td>
            <td>Compost thermophile mûr</td>
            <td class="num-val">200 L / 30 m</td>
            <td>À incorporer superficiellement au croc</td>
          </tr>
        </tbody>
      </table>
    </div>

    <h3 class="subsection-title" style="margin-top: var(--space-8);">Badges de Statut &amp; Labels Métier</h3>
    <div style="display: flex; gap: var(--space-2); flex-wrap: wrap; align-items: center; margin-bottom: var(--space-6);">
      <span class="badge badge-bio"><span class="badge-dot"></span> 100% Bio Certifié</span>
      <span class="badge badge-seed"><span class="badge-dot"></span> Semence Paysanne</span>
      <span class="badge badge-brand"><span class="badge-dot"></span> Saison Sèche 2026</span>
      <span class="badge badge-accent"><span class="badge-dot"></span> Terroir Sahélien</span>
      <span class="badge badge-stock"><span class="badge-dot"></span> En stock (Planches A &amp; B)</span>
      <span class="badge badge-warning"><span class="badge-dot"></span> Dernières récoltes</span>
      <span class="badge badge-danger"><span class="badge-dot"></span> Intrant Interdit</span>
    </div>

    <h3 class="subsection-title" style="margin-top: var(--space-8);">Cartes Produits &amp; Fiches Pédagogiques</h3>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-6); margin-bottom: var(--space-6);">
      <div class="card card-interactive">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--space-3);">
          <span class="badge badge-bio"><span class="badge-dot"></span> Récolté ce matin</span>
          <span class="font-mono" style="font-weight: 700; color: var(--color-brand-secondary); font-size: var(--text-lg);">1 500 FCFA <span style="font-size: var(--text-xs); color: var(--color-ink-faint); font-weight: 400;">/ kg</span></span>
        </div>
        <h4 class="card-title">Tomate Roma Sélection Sahel</h4>
        <p class="card-subtitle">Variété paysanne acclimatée · Chair dense, sans traitement chimique de synthèse</p>
        <div style="display: flex; gap: var(--space-2); margin-top: var(--space-4); align-items: center;">
          <button type="button" class="btn btn-primary" style="flex: 1; justify-content: center;">Commander</button>
          <button type="button" class="btn btn-secondary" style="padding: var(--space-3);" title="Fiche variétale">ℹ</button>
        </div>
      </div>

      <div class="card card-sunken">
        <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-3);">
          <span class="badge badge-accent">Module 03</span>
          <span style="font-size: var(--text-xs); color: var(--color-ink-faint); font-weight: 500;">Durée : 45 min</span>
        </div>
        <h4 class="card-title" style="font-size: var(--text-lg);">Compost Thermophile Sahélien</h4>
        <p style="font-size: var(--text-sm); color: var(--color-ink-soft); line-height: var(--leading-relaxed); margin-bottom: var(--space-4);">
          Règle du ratio Carbone/Azote (C/N = 30), aération passive et montée en température à 65°C pour assainir les adventices.
        </p>
        <a href="#" class="btn btn-secondary" style="display: inline-flex;">Télécharger le protocole PDF &rarr;</a>
      </div>
    </div>

    <h3 class="subsection-title" style="margin-top: var(--space-8);">Formulaires &amp; Saisie Accessible</h3>
    <div style="max-width: 580px; margin-bottom: var(--space-6);">
      <form class="card" onsubmit="event.preventDefault();">
        <div class="form-group">
          <label for="demo-prod" class="form-label">Nom du maraîcher / Exploitation <span class="required">*</span></label>
          <input type="text" id="demo-prod" class="form-input" placeholder="Ex: Bakary Coulibaly" required />
          <p class="form-hint">Nom du responsable pour la distribution des semences reproductibles.</p>
        </div>
        <div class="form-group">
          <label for="demo-variety" class="form-label">Variété de semence souhaitée <span class="required">*</span></label>
          <select id="demo-variety" class="form-select" required>
            <option value="">Sélectionner une variété...</option>
            <option value="gombo">Gombo Clemson Spineless</option>
            <option value="tomate">Tomate Roma Sélection Sahel</option>
            <option value="oignon">Oignon Violet de Galmi</option>
          </select>
        </div>
        <div style="display: flex; gap: var(--space-3); justify-content: flex-end; margin-top: var(--space-4);">
          <button type="button" class="btn btn-secondary">Réinitialiser</button>
          <button type="submit" class="btn btn-primary">Enregistrer la fiche</button>
        </div>
      </form>
    </div>
  </section>

  <!-- ======================================================================
       SECTION 4 : ESPACEMENT & FORMES
       ====================================================================== -->
  <section class="ds-section" id="spacing">
    <div class="section-label">04. Espacement &amp; Formes</div>
    <h2 class="section-heading">Grille d'Espacement &amp; Rayons de Courbure</h2>
    <p class="section-sub">Tous les espacements suivent une grille modulaire base 4px / 8px. Les rayons restent doux et naturels.</p>

    <h3 class="subsection-title">Échelle d'Espacement</h3>
    <div class="spacing-list">
      <div class="spacing-row">
        <code class="spacing-token">--space-1</code>
        <div class="spacing-bar" style="width: 4px;"></div>
        <span class="spacing-value">4px</span>
      </div>
      <div class="spacing-row">
        <code class="spacing-token">--space-2</code>
        <div class="spacing-bar" style="width: 8px;"></div>
        <span class="spacing-value">8px</span>
      </div>
      <div class="spacing-row">
        <code class="spacing-token">--space-3</code>
        <div class="spacing-bar" style="width: 12px;"></div>
        <span class="spacing-value">12px</span>
      </div>
      <div class="spacing-row">
        <code class="spacing-token">--space-4</code>
        <div class="spacing-bar" style="width: 16px;"></div>
        <span class="spacing-value">16px</span>
      </div>
      <div class="spacing-row">
        <code class="spacing-token">--space-6</code>
        <div class="spacing-bar" style="width: 24px;"></div>
        <span class="spacing-value">24px</span>
      </div>
      <div class="spacing-row">
        <code class="spacing-token">--space-8</code>
        <div class="spacing-bar" style="width: 32px;"></div>
        <span class="spacing-value">32px</span>
      </div>
      <div class="spacing-row">
        <code class="spacing-token">--space-10</code>
        <div class="spacing-bar" style="width: 40px;"></div>
        <span class="spacing-value">40px</span>
      </div>
      <div class="spacing-row">
        <code class="spacing-token">--space-12</code>
        <div class="spacing-bar" style="width: 48px;"></div>
        <span class="spacing-value">48px</span>
      </div>
      <div class="spacing-row">
        <code class="spacing-token">--space-16</code>
        <div class="spacing-bar" style="width: 64px;"></div>
        <span class="spacing-value">64px</span>
      </div>
    </div>

    <h3 class="subsection-title" style="margin-top: var(--space-10);">Rayons de Courbure</h3>
